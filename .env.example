# Setup code: needed once to create the first dashboard account and to set the finance password
# Use a long random value, e.g. node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
ADMIN_TOKEN=

# Postgres (Neon) — all app data (events, guests, RSVPs, orders...). Required on Vercel.
# Set automatically by the Neon integration on Vercel; `vercel env pull` copies it into .env.local.
# Create the tables once: node --env-file=.env.local scripts/db-setup.mjs
DATABASE_URL=
# Local development uses data/store.json; set to "postgres" to use DATABASE_URL instead (the live database!).
NAILA_DB=

# Cloudflare R2 — template videos and posters. Leave empty in development to store on local disk.
# Cloudflare dashboard → R2 → Manage API tokens → "Object Read & Write" on this bucket only.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# The bucket's public domain, e.g. https://media.example.com (custom domain) or https://pub-xxxx.r2.dev
R2_PUBLIC_URL=

# ---- Business ----
# Brand name shown on the site (pending with Ahmad)
BRAND_NAME=
# Our WhatsApp, international digits only, e.g. 201001234567
WHATSAPP_NUMBER=
# Instapay address clients transfer to, e.g. name@instapay
INSTAPAY_HANDLE=
# Public site address, e.g. https://example.com (used for payment redirects)
SITE_URL=

# Microsoft Clarity public project ID (Naila: zix47fxhih). Blank disables Clarity.
NEXT_PUBLIC_CLARITY_PROJECT_ID=

# ---- Paymob (Ziad) ----  Dashboard → Settings → Account info. Leave empty to offer Instapay only.
PAYMOB_SECRET_KEY=
PAYMOB_PUBLIC_KEY=
# Comma-separated integration IDs (card, wallet, Apple Pay...)
PAYMOB_INTEGRATION_IDS=
PAYMOB_HMAC_SECRET=

# ---- Daily cleanup of guest data a year after the event (Vercel Cron sends this) ----
CRON_SECRET=

# Signs dashboard login sessions (long random value). Changing it signs everyone out.
SESSION_SECRET=
